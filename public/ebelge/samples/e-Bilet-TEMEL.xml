<?xml version="1.0" encoding="UTF-8"?>
<!--
  e-Bilet (Yolcu Beraberinde Eşya Taşıma Bileti / Uçak/Otobüs bileti) örnek XML
  UBL-TR 1.2.1 SelfBilledInvoice
  Şema: eBilet.xsd — yolcu/sefer/koltuk bilgili
  NOT: e-Bilet'in GİB'de farklı senaryoları var: UBLTR-SCT-TR1.2.1 eki mevcut olmayabilir.
       Şu anki community XSLT Invoice yapısını kabul edip yolcu/seyahat bilgisini
       InvoiceNote veya AdditionalDocumentReference ile taşıyoruz.

  Özellikler:
  - Yolcu bilgisi (Ad/Soyad, TCKN)
  - Sefer bilgisi (kalkış-varış, tarih-saat)
  - Koltuk no
  - Bilet bedeli
-->
<Invoice
    xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:ubltr="urn:oasis:names:specification:ubl:schema:xsd:TurkishCustomizationExtensionComponents">
    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>TR1.2</cbc:CustomizationID>
    <cbc:ProfileID>e-Bilet</cbc:ProfileID>
    <cbc:ID>BLT2026000000001</cbc:ID>
    <cbc:CopyIndicator>false</cbc:CopyIndicator>
    <cbc:UUID>33333333-4444-5555-6666-777777777777</cbc:UUID>
    <cbc:IssueDate>2026-09-25</cbc:IssueDate>
    <cbc:IssueTime>09:15:00</cbc:IssueTime>
    <cbc:InvoiceTypeCode>BILETLISEYEHAT</cbc:InvoiceTypeCode>
    <cbc:DocumentCurrencyCode>TRY</cbc:DocumentCurrencyCode>
    <cbc:LineCountNumeric>1</cbc:LineCountNumeric>

    <!-- Müşteri (taşıyıcı/acenteye bilet satışı yapan acente/uygulama) -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="VKN">5556667778</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Dijital Bilet Satış A.Ş.</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Atatürk Havalimanı Yolu</cbc:StreetName>
                <cbc:CitySubdivisionName>Yeşilköy</cbc:CitySubdivisionName>
                <cbc:CityName>İstanbul</cbc:CityName>
                <cac:Country>
                    <cbc:Name>Türkiye</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cac:TaxScheme>
                    <cbc:ID>0001</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- Tedarikçi (havayolu/taşıyıcı) — bileti kesen -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="VKN">1112223334</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Anadolu Hava Yolları A.O.</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Havalimanı Cad.</cbc:StreetName>
                <cbc:CitySubdivisionName>Esenboğa</cbc:CitySubdivisionName>
                <cbc:CityName>Ankara</cbc:CityName>
                <cac:Country>
                    <cbc:Name>Türkiye</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cac:TaxScheme>
                    <cbc:ID>0001</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- Yolcu bilgisi için AdditionalDocumentReference -->
    <cac:AdditionalDocumentReference>
        <cbc:ID>YOLCU</cbc:ID>
        <cbc:DocumentType>Yolcu Bilgisi</cbc:DocumentType>
        <cac:Attachment>
            <cbc:EmbeddedDocumentBinary>
                <cbc:Name>Yolcu TCKN</cbc:Name>
                <cbc:Value>45678901234</cbc:Value>
            </cbc:EmbeddedDocumentBinary>
        </cac:Attachment>
    </cac:AdditionalDocumentReference>

    <!-- Sefer bilgisi -->
    <cac:AdditionalDocumentReference>
        <cbc:ID>SEFER</cbc:ID>
        <cbc:DocumentType>Sefer Bilgisi</cbc:DocumentType>
        <cbc:Comment>TK2014 IST → ESB 25.09.2026 14:30 Koltuk 14A</cbc:Comment>
    </cac:AdditionalDocumentReference>

    <!-- KDV %20 -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="TRY">150.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="TRY">750.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="TRY">150.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>0020</cbc:ID>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>0015</cbc:ID>
                    <cbc:Name>KDV</cbc:Name>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="TRY">750.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="TRY">750.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="TRY">900.00</cbc:TaxInclusiveAmount>
        <cbc:AllowanceTotalAmount currencyID="TRY">0.00</cbc:AllowanceTotalAmount>
        <cbc:PayableAmount currencyID="TRY">900.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- Bilet satırı -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="TRY">750.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>TK2014 İstanbul (IST) → Esenboğa (ESB), 25.09.2026 14:30, Koltuk 14A — Havayolu yolcu bileti</cbc:Description>
            <cbc:Name>Yolcu Bileti (Ekonomi Sınıfı)</cbc:Name>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="TRY">750.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
