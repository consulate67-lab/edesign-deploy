<?xml version="1.0" encoding="UTF-8"?>
<!--
  e-SMM (Serbest Meslek Makbuzu) örnek XML
  UBL-TR 1.2.1 SelfBilledInvoice
  Resmi GİB paketi: eSMMSerbestMeslekPaketi.zip
  URL: https://ebelge.gib.gov.tr/dosyalar/kilavuzlar/eSMMSerbestMeslekPaketi.zip
  Şema: eSMM.xsd (SelfBilledInvoice özelleştirmesi)
  Hukuki dayanak: 213 sayılı VUK Md. 236, GİB 509 sıra no'lu tebliğ

  Özellikler:
  - Serbest meslek erbabı (doktor, avukat, mühendis vb.)
  - BRÜT ücret - KDV istisna (Madde 18) - stopaj (GVK Md. 94) = NET ödeme
  - Gerçek kişi (TCKN) ile
  - TC Kimlik No, vergi dairesi, mükellefiyet bilgisi
-->
<Invoice
    xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
    xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
    xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
    xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
    xmlns:ubltr="urn:oasis:names:specification:ubl:schema:xsd:TurkishCustomizationExtensionComponents">
    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID>TR1.2</cbc:CustomizationID>
    <cbc:ProfileID>e-SMM</cbc:ProfileID>
    <cbc:ID>SMM2026000000001</cbc:ID>
    <cbc:CopyIndicator>false</cbc:CopyIndicator>
    <cbc:UUID>11111111-2222-3333-4444-555555555555</cbc:UUID>
    <cbc:IssueDate>2026-09-25</cbc:IssueDate>
    <cbc:IssueTime>10:30:00</cbc:IssueTime>
    <cbc:InvoiceTypeCode>SMM</cbc:InvoiceTypeCode>
    <cbc:DocumentCurrencyCode>TRY</cbc:DocumentCurrencyCode>
    <cbc:LineCountNumeric>1</cbc:LineCountNumeric>

    <!-- Müşteri (hizmeti alan kurum) — Fatura kesen kurum -->
    <cac:AccountingCustomerParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="VKN">1234567890</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Hizmet Alan Kurum A.Ş.</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:ID>12345</cbc:ID>
                <cbc:StreetName>Levent Mah. Büyükdere Cad.</cbc:StreetName>
                <cbc:BuildingNumber>45</cbc:BuildingNumber>
                <cbc:CitySubdivisionName>Beşiktaş</cbc:CitySubdivisionName>
                <cbc:CityName>İstanbul</cbc:CityName>
                <cbc:PostalZone>34394</cbc:PostalZone>
                <cac:Country>
                    <cbc:Name>Türkiye</cbc:Name>
                    <cbc:IdentificationCode>TR</cbc:IdentificationCode>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cac:TaxScheme>
                    <cbc:ID>0001</cbc:ID>
                    <cbc:Name>Levent</cbc:Name>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
        </cac:Party>
    </cac:AccountingCustomerParty>

    <!-- Tedarikçi (serbest meslek erbabı — gerçek kişi) -->
    <cac:AccountingSupplierParty>
        <cac:Party>
            <cac:PartyIdentification>
                <cbc:ID schemeID="TCKN">12345678901</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name>Dr. Ahmet YILMAZ</cbc:Name>
            </cac:PartyName>
            <cac:PostalAddress>
                <cbc:StreetName>Bağdat Cad.</cbc:StreetName>
                <cbc:BuildingNumber>120</cbc:BuildingNumber>
                <cbc:CitySubdivisionName>Kadıköy</cbc:CitySubdivisionName>
                <cbc:CityName>İstanbul</cbc:CityName>
                <cac:Country>
                    <cbc:Name>Türkiye</cbc:Name>
                </cac:Country>
            </cac:PostalAddress>
            <cac:PartyTaxScheme>
                <cac:TaxScheme>
                    <cbc:ID>0010</cbc:ID>
                    <cbc:Name>Kadıköy</cbc:Name>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:Person>
                <cbc:FirstName>Ahmet</cbc:FirstName>
                <cbc:FamilyName>YILMAZ</cbc:FamilyName>
                <cbc:Title>Dr.</cbc:Title>
            </cac:Person>
        </cac:Party>
    </cac:AccountingSupplierParty>

    <!-- Stopaj (Gelir Vergisi) ve KDV İstisna bilgisi -->
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="TRY">0.00</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="TRY">10000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="TRY">0.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>0015</cbc:ID>
                <cbc:Name>KDV İstisna</cbc:Name>
                <cbc:TaxExemptionReasonCode>17/4-a</cbc:TaxExemptionReasonCode>
                <cbc:TaxExemptionReason>213 sayılı VUK 17/4-a maddesi kapsamında KDV'den müstesna serbest meslek hizmeti</cbc:TaxExemptionReason>
                <cac:TaxScheme>
                    <cbc:ID>0015</cbc:ID>
                    <cbc:Name>KDV</cbc:Name>
                    <cbc:TaxTypeCode>0015</cbc:TaxTypeCode>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="TRY">10000.00</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="TRY">2000.00</cbc:TaxAmount>
            <cac:TaxCategory>
                <cbc:ID>0001</cbc:ID>
                <cbc:Name>Gelir Vergisi Stopajı</cbc:Name>
                <cbc:Percent>20.00</cbc:Percent>
                <cac:TaxScheme>
                    <cbc:ID>0001</cbc:ID>
                    <cbc:Name>Gelir Vergisi</cbc:Name>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>

    <!-- Toplamlar: BRÜT 10000 - Stopaj 2000 = NET 8000 -->
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="TRY">10000.00</cbc:LineExtensionAmount>
        <cbc:TaxExclusiveAmount currencyID="TRY">10000.00</cbc:TaxExclusiveAmount>
        <cbc:TaxInclusiveAmount currencyID="TRY">10000.00</cbc:TaxInclusiveAmount>
        <cbc:AllowanceTotalAmount currencyID="TRY">0.00</cbc:AllowanceTotalAmount>
        <cbc:PayableAmount currencyID="TRY">8000.00</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>

    <!-- Hizmet satırı -->
    <cac:InvoiceLine>
        <cbc:ID>1</cbc:ID>
        <cbc:InvoicedQuantity unitCode="C62">1</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="TRY">10000.00</cbc:LineExtensionAmount>
        <cac:Item>
            <cbc:Description>Eylül 2026 dönemi danışmanlık hizmeti (20 saat)</cbc:Description>
            <cbc:Name>Mühendislik Danışmanlık Hizmeti</cbc:Name>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="TRY">10000.00</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
</Invoice>
