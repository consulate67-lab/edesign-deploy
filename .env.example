# Sprint 1.4 — Environment variables template
# Bu dosya .env.example (commit edilir). Production'de Railway dashboard'dan set edilir.

# ===== Backend (server/index.js) =====
NODE_ENV=production
PORT=3002
JWT_SECRET=<64-char random secret>

# CORS — frontend origin'ler
# Production: api.edesign-deploy.com + www.edesign-deploy.com
# Local dev: http://localhost:5173, http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3002,https://edesign-deploy.com,https://www.edesign-deploy.com

# Database
DATABASE_URL=postgresql://user:pass@host:port/dbname
PGSSL=true

# Admin (one-time password reset + kredi ekleme)
ADMIN_KEY=<random 32-char string>

# ===== Iyzico (production) =====
IYZICO_API_KEY=<iyzico sandbox/api key>
IYZICO_SECRET=<iyzico sandbox/secret key>
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_CALLBACK_URL=https://api.edesign-deploy.com/api/payment/iyzico/callback

# ===== Frontend (Vite, build-time) =====
# .env.production icin kullanilir
VITE_API_URL=https://api.edesign-deploy.com/api