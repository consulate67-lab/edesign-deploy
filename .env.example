# ============================================
# D:\EIslemler environment variables (example)
# ============================================
# Copy this file to `.env` (gitignored) and fill in the values.
# The server loads these via `process.env.*`. The client (Vite) only
# reads variables prefixed with `VITE_`.

# --- Server (Express) ---
NODE_ENV=development
PORT=3002
# Bind address — 0.0.0.0 inside containers, 127.0.0.1 for local-only dev
HOST=0.0.0.0

# REQUIRED in production. The dev fallback is unsafe and prints a warning.
# Generate a strong key with: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=

# Comma-separated origin allowlist for CORS.
# Production example (GitHub Pages frontend + Railway backend):
#   https://consulate67-lab.github.io,https://<your-app>.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3002,http://127.0.0.1:5173,http://127.0.0.1:3002

# SQLite location. Locally defaults to ./server/database.sqlite;
# in production defaults to /data/database.sqlite (Railway volume mount).
# Override only if you mount the volume elsewhere.
DATABASE_PATH=

# --- Client (Vite, must be prefixed VITE_) ---
# Where the frontend should send API requests. Leave empty in dev (defaults
# to http://localhost:3002/api). In production set this to the backend URL:
#   VITE_API_URL=https://<your-app>.up.railway.app/api
VITE_API_URL=
