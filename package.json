  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "echo 'backend-only deploy, skipping frontend build' && exit 0",
    "build:frontend": "tsc -p tsconfig.app.json && vite build",
    "gen:xslt-defaults": "node scripts/gen-xslt-defaults.cjs",
    "start": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run gen:xslt-defaults && npm run build:frontend",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
