# YouTube Data API OAuth (asla commit etme — gerçek değerler .env.youtube)
YOUTUBE_CLIENT_ID=xxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5199
YOUTUBE_REFRESH_TOKEN=
# 1 = egitim MP4'lerini FTP'ye yukleme (YouTube embed canliysa)
YOUTUBE_SKIP_EGITIM_MP4=0
